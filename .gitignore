# Local Sites configuration
# conf/ is deliberately NOT ignored: working rule 3 requires every config file we
# change to be in git, and the nginx FastCGI cache directives live in
# conf/nginx/*.hbs (Local regenerates the runtime config from these templates).

# WordPress core (reinstallable)
app/public/wp-admin/
app/public/wp-includes/
app/public/wp-*.php
# ...but wp-config.php is ours, not core, and rule 3 requires it tracked.
!app/public/wp-config.php
app/public/index.php
app/public/xmlrpc.php
app/public/license.txt
app/public/readme.html

# Sensitive config
# wp-config.php is deliberately NOT ignored: working rule 3 lists it explicitly,
# and Phase 2/7 change it (WP_CACHE, WP_POST_REVISIONS, cache constants).
# Safe here because the repository is private and this is a local development
# install whose DB credentials are Local's defaults. The auth salts it contains
# are development-only -- REGENERATE THEM before any production deployment.

# Uploads & generated files
app/public/wp-content/uploads/
app/public/wp-content/cache/
app/public/wp-content/upgrade/
app/public/wp-content/backup-db/
app/public/wp-content/advanced-cache.php
app/public/wp-content/wp-cache-config.php

# Default WordPress themes (not custom)
app/public/wp-content/themes/twentytwentythree/
app/public/wp-content/themes/twentytwentyfour/
app/public/wp-content/themes/twentytwentyfive/

# OS / editor files
.DS_Store
Thumbs.db
*.log
node_modules/

# Local Sites service logs (nginx/php/mysql/mailpit), incl. non-".log" snapshots
logs/

# Local-generated, machine-specific (points at the host's service paths)
app/.envrc

# LiteSpeed cache data
app/public/wp-content/litespeed/

# LiteSpeed's own .htaccess backup
app/public/.htaccess.bk

# Lighthouse HTML reports are large; the JSON is what the numbers come from
reports/*.report.html

# nginx FastCGI cache store (Phase 2A) - generated at runtime
app/nginx-cache/
