upstream php {
  {{#each fastcgi_servers}}
  server {{this}};
  {{/each}}
}

server {
	listen 127.0.0.1:{{port}};
	listen [::1]:{{port}};
    root   "{{root}}";

    index index.php index.html index.htm;

    #
    # Generic restrictions for things like PHP files in uploads
    #
	include includes/restrictions.conf;

    #
	# Gzip rules
	#
	include includes/gzip.conf;

    #
	# WordPress Rules
	#
    {{#unless site.multiSite}}
    include includes/wordpress-single.conf;
    {{else}}
    include includes/wordpress-multi.conf;
    {{/unless}}

	#
	# Phase 2A - decide what may be served from the FastCGI cache
	#
	# Order matters: each rule can only ever set the flag, never clear it.
	#
	set $skip_cache 0;

	# Anything that mutates state.
	if ($request_method != GET) { set $skip_cache 1; }

	# Real query strings bypass; tracking-only ones do not, because $clean_args
	# (see nginx.conf) has already had utm_*/fbclid/gclid stripped out.
	if ($clean_args != "") { set $skip_cache 1; }

	# WooCommerce pages confirmed from the DB: cart=9 /cart/, checkout=10
	# /checkout/, my-account=11 /my-account/. Also the theme's own /ajax-api/
	# endpoints, which return per-request JSON.
	if ($request_uri ~* "/wp-admin/|/wp-login\.php|/wp-json/|/wc-api/|/wp-cron\.php|/xmlrpc\.php|/feed/|sitemap(_index)?\.xml|/cart/?|/checkout/?|/my-account/?|/ajax-api/|\?add-to-cart=|wc-ajax=") {
		set $skip_cache 1;
	}

	# Anyone with a session: logged in, commenting, or holding a cart.
	if ($http_cookie ~* "comment_author|wordpress_[a-f0-9]+|wp-postpass|wordpress_no_cache|wordpress_logged_in|woocommerce_items_in_cart|woocommerce_cart_hash|wp_woocommerce_session_") {
		set $skip_cache 1;
	}

	#
	# Forward 404's to WordPress
	#
	error_page 404 = @wperror;
	location @wperror {
		rewrite ^/(.*)$ /index.php?q=$1 last;
	}

    #
	# Static file rules
	#
	# Phase 6.4 -- static asset cache lifetimes.
    #
    # Local's defaults were "no-cache, must-revalidate" for CSS/JS and a
    # five-minute max-age for images and fonts, so Lighthouse flagged 345 KB of
    # assets being refetched or revalidated on every visit.
    #
    # Every one of these URLs is versioned -- WordPress appends ?ver= and this
    # project's own stylesheets use filemtime() -- so the bytes behind a given
    # URL never change. A long max-age with immutable is therefore correct, and
    # is what makes repeat visits and Phase 5 prerendering nearly free.
    #
    # immutable also stops the browser revalidating on reload, which the old
    # no-cache value forced it to do every single time.
    location ~* \.(?:css|js)$ {
        access_log        off;
        log_not_found     off;
        add_header        Cache-Control "public, max-age=31536000, immutable";
    }

    # Phase 6.8 -- content-negotiated WebP.
    #
    # This block must come before the general image rule below, because nginx
    # takes the first matching regex location.
    #
    # The URL never changes: the page still asks for foo.png, and $webp_suffix
    # (see nginx.conf) makes try_files look for foo.png.webp first when, and
    # only when, the browser said it accepts image/webp. Anything without a
    # converted sibling falls straight through to the original, so this is safe
    # on files tools/make-webp.php skipped or rejected.
    #
    # Vary: Accept is required -- without it a shared cache could hand a WebP
    # to a client that cannot display it.
    location ~* \.(?:jpe?g|png)$ {
        access_log        off;
        log_not_found     off;
        add_header        Cache-Control "public, max-age=31536000, immutable";
        add_header        Vary Accept;
        try_files         $uri$webp_suffix $uri =404;
    }

    location ~* \.(?:jpg|jpeg|gif|png|webp|avif|ico|svg|xml)$ {
        access_log        off;
        log_not_found     off;
        add_header        Cache-Control "public, max-age=31536000, immutable";
    }

    location ~* \.(?:eot|woff|woff2|ttf|otf) {
        access_log        off;
        log_not_found     off;

        add_header        Cache-Control "public, max-age=31536000, immutable";

        # allow CORS requests
        add_header        Access-Control-Allow-Origin *;
    }

    #
    # PHP-FPM
    #
	location ~ \.php$ {
		try_files $uri =404;

		fastcgi_split_path_info ^(.+\.php)(/.+)$;

		fastcgi_param   QUERY_STRING            $query_string;
		fastcgi_param   REQUEST_METHOD          $request_method;
		fastcgi_param   CONTENT_TYPE            $content_type;
		fastcgi_param   CONTENT_LENGTH          $content_length;

		fastcgi_param   SCRIPT_FILENAME         $document_root$fastcgi_script_name;
		fastcgi_param   SCRIPT_NAME             $fastcgi_script_name;
		fastcgi_param   PATH_INFO               $fastcgi_path_info;
		fastcgi_param   PATH_TRANSLATED         $document_root$fastcgi_path_info;
		fastcgi_param   REQUEST_URI             $request_uri;
		fastcgi_param   DOCUMENT_URI            $document_uri;
		fastcgi_param   DOCUMENT_ROOT           $document_root;
		fastcgi_param   SERVER_PROTOCOL         $server_protocol;

		fastcgi_param   GATEWAY_INTERFACE       CGI/1.1;
		fastcgi_param   SERVER_SOFTWARE         nginx/$nginx_version;

		fastcgi_param   REMOTE_ADDR             $remote_addr;
		fastcgi_param   REMOTE_PORT             $remote_port;
		fastcgi_param   SERVER_ADDR             $server_addr;
		fastcgi_param   SERVER_PORT             $server_port;
		fastcgi_param   SERVER_NAME             $host;

		fastcgi_param   HTTPS                   $fastcgi_https;

		fastcgi_param   REDIRECT_STATUS         200;

		fastcgi_index index.php;
		fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;

		fastcgi_pass php;
		fastcgi_buffer_size      64k;
		fastcgi_buffers          32 32k;
		fastcgi_read_timeout	 1200s;

		#
		# Phase 2A - FastCGI cache
		#
		# Note this upstream is "php", a pool of php-cgi workers on TCP ports.
		# There is no PHP-FPM on Windows, so the usual unix-socket fastcgi_pass
		# from the brief does not apply here.
		#
		fastcgi_cache_bypass $skip_cache;
		fastcgi_no_cache     $skip_cache;
		fastcgi_cache        WORDPRESS;
		fastcgi_cache_valid  200 301 302 24h;
		fastcgi_cache_valid  404 10m;

		# Serve stale while revalidating, so only one visitor per page per day
		# pays the full PHP cost rather than everyone who arrives during a rebuild.
		fastcgi_cache_use_stale error timeout updating http_500 http_503;
		fastcgi_cache_background_update on;
		fastcgi_cache_lock on;
		fastcgi_cache_min_uses 1;

		add_header X-FastCGI-Cache $upstream_cache_status always;
		add_header X-Cache-Skipped $skip_cache always;

		proxy_buffer_size        64k;
		proxy_buffers            32 32k;
		proxy_busy_buffers_size  256k;
	}
}
